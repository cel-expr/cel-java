load("@rules_java//java:defs.bzl", "java_test")
load("//:cel_android_rules.bzl", "cel_android_local_test")

package(
    default_applicable_licenses = ["//:license"],
    default_testonly = True,
)

cel_android_local_test(
    name = "cel_lite_descriptor_test",
    srcs = ["CelLiteDescriptorTest.java"],
    test_class = "dev.cel.protobuf.CelLiteDescriptorTest",
    deps = [
        "//:java_truth",
        "//protobuf:cel_lite_descriptor",
        "//testing/protos:accessor_names_cel_java_proto_lite",
        "//testing/protos:accessor_names_java_proto_lite",
        "//testing/protos:test_all_types_cel_java_proto3_lite",
        "@cel_conformance//proto/cel/expr/conformance/proto3:test_all_types_java_proto_lite",
        "@maven//:com_google_testparameterinjector_test_parameter_injector",
        "@maven//:junit_junit",
        "@maven_android//:com_google_protobuf_protobuf_javalite",
    ],
)

java_test(
    name = "proto_descriptor_collector_test",
    srcs = ["ProtoDescriptorCollectorTest.java"],
    test_class = "dev.cel.protobuf.ProtoDescriptorCollectorTest",
    # Also a runtime dep so that, in OSS, full protobuf precedes the lite runtime (from
    # lite_descriptor_codegen_metadata) on the classpath: both define DescriptorProtos.
    runtime_deps = ["@maven//:com_google_protobuf_protobuf_java"],  # keep
    deps = [
        "//:java_truth",
        "//protobuf:debug_printer",
        "//protobuf:lite_descriptor_codegen_metadata",
        "//protobuf:proto_descriptor_collector",
        "//testing/protos:accessor_names_java_proto",
        "//testing/protos:multi_file_java_proto",
        "@cel_conformance//proto/cel/expr/conformance/proto2:test_all_types_java_proto",
        "@cel_conformance//proto/cel/expr/conformance/proto3:test_all_types_java_proto",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:com_google_testparameterinjector_test_parameter_injector",
        "@maven//:junit_junit",
    ],
)
