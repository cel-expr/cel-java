    "parse/struct_field_names",
    "proto2/empty_field/scalar_with_default",
    "proto2/literal_singular",
    "proto2/literal_wellknown",
    "proto2/set_null",
    "proto2/quoted_fields",
    "proto2/has/repeated_none_explicit,repeated_one,repeated_many,map_none_explicit,map_one_default,map_one,map_many,required,optional_set_no_default,optional_set_with_default,optional_set_to_default,optional_message_set,optional_enum_set,optional_enum_set_zero,oneof_other_set,oneof_set,oneof_set_default",
    "proto3/literal_singular",
    "proto3/literal_wellknown",
    "proto3/set_null",
    "proto3/quoted_fields",
    "proto3/has/repeated_none_explicit,repeated_one,repeated_many,map_none_explicit,map_one_default,map_one,map_many,single_set,single_set_to_default,single_message_set,single_message_set_to_default,single_enum_set,single_enum_set_zero,oneof_other_set,oneof_set,oneof_set_default",
    "type_deductions/complex_initializers/struct",
    "type_deductions/field_access/int_field",
    "wrappers",
]

