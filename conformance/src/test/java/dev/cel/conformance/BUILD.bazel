    data = _ALL_TESTS,
    mode = MODE.MAVEN_TEST,
    skip_tests = _TESTS_TO_SKIP_LEGACY,
)

conformance_test(
    name = "conformance_dashboard",
    data = _ALL_TESTS,
    mode = MODE.DASHBOARD,
)

conformance_test(
    name = "conformance_planner",
    data = _ALL_TESTS,
