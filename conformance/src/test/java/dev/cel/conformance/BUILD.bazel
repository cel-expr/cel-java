    "wrappers/uint64/to_null",
]

_TESTS_TO_SKIP_LITE = _TESTS_TO_SKIP_LITE_BASE + [
    # Custom proto2 default values on unset fields require SelectOptimization in CelLiteRuntime.
    "proto2/empty_field/scalar_with_default",
]

conformance_test(
    name = "conformance",
    data = _ALL_TESTS,
    skip_tests = _TESTS_TO_SKIP_LEGACY,
)

