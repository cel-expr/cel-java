    # Future features for CEL 1.0
    # TODO: Strong typing support for enums, specified but not implemented.
    "enums/strong_proto2",
    "enums/strong_proto3",
]

_TESTS_TO_SKIP_LITE_BASE = _TESTS_TO_SKIP_PLANNER + [
    # Proto2 extensions are not supported in CelLiteRuntime.
    "proto2_ext",
    "proto2/extensions_has",
    "proto2/extensions_get",

    # TODO: Message equality is not yet supported in CelLiteRuntime.
    "comparisons/eq_literal/not_eq_dyn_proto2_msg_null,not_eq_dyn_proto3_msg_null",
    "comparisons/eq_wrapper/eq_proto2,eq_proto3,eq_proto2_missing_fields_neq,eq_proto3_missing_fields_neq,eq_proto_nan_equal,eq_proto_different_types",
