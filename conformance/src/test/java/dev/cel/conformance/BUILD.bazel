    "comparisons/ne_literal/ne_proto2,ne_proto3,ne_proto2_missing_fields_neq,ne_proto3_missing_fields_neq,ne_proto_nan_not_equal,ne_proto_different_types",
    "comparisons/ne_literal/ne_proto2_any_unpack,ne_proto2_any_unpack_bytewise_fallback,ne_proto3_any_unpack,ne_proto3_any_unpack_bytewise_fallback",
    "proto2/quoted_fields/set_field_with_quoted_name",
    "proto2/set_null/single_message,single_duration,single_timestamp",
    "proto3/quoted_fields/set_field",
