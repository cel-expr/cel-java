# Deployable workflow. The sub-policies are linked in BUILD; text_risk is only evaluated when the
# channel precondition passes, and at most once.
name: "workflow"
rule:
  match:
  - condition: "decisions.channel == 'UNKNOWN'"
    output: "'IGNORE'"
  - condition: "decisions.text_risk == 'HIGH'"
    output: "'BLOCK'"
  - output: "'ALLOW'"
