load("@rules_java//java:defs.bzl", "java_library")
load("@rules_proto//proto:defs.bzl", "proto_descriptor_set")
load("//:testing.bzl", "junit4_test_suites")
load("//policy/tools:compile_cel_policy.bzl", "compile_cel_policy")

package(
    default_applicable_licenses = ["//:license"],
    default_testonly = True,
)

proto_descriptor_set(
    name = "test_all_types_fds",
    deps = ["@cel_spec//proto/cel/expr/conformance/proto3:test_all_types_proto"],
)

compile_cel_policy(
    name = "compiled_test_policy",
    config = "//testing/environment:proto3_message_variables",
    optimize_field_selection = True,
    policy = ":test_policy.yaml",
    proto_srcs = ["@cel_spec//proto/cel/expr/conformance/proto3:test_all_types_proto"],
    simple_variables = True,
)

# Example of module based evaluation: each sub-policy is compiled and owned separately, then
# statically linked into the deployable workflow as `decisions.*` identifiers.
compile_cel_policy(
    name = "channel_decision",
    config = "decisions/environment.yaml",
    policy = "decisions/channel.celpolicy",
)

compile_cel_policy(
    name = "text_risk_decision",
    config = "decisions/environment.yaml",
    policy = "decisions/text_risk.celpolicy",
)

compile_cel_policy(
    name = "workflow",
    config = "decisions/environment.yaml",
    decisions = {
        "decisions.channel": ":channel_decision",
        "decisions.text_risk": ":text_risk_decision",
    },
    policy = "decisions/workflow.celpolicy",
)

java_library(
    name = "tests",
    testonly = True,
    srcs = glob(["*Test.java"]),
    data = [
        ":compiled_test_policy.binarypb",
        ":test_all_types_fds",
        ":workflow.binarypb",
        "//testing/environment:proto3_message_variables",
    ],
    deps = [
        "//:java_truth",
        "//common:cel_ast",
        "//common:cel_source",
        "//common:proto_ast",
        "//extensions:optional_library",
        "//policy/tools",
        "//runtime",
        "//runtime:function_binding",
        "@bazel_tools//tools/java/runfiles",
        "@cel_spec//proto/cel/expr:checked_java_proto",
        "@cel_spec//proto/cel/expr/conformance/proto3:test_all_types_java_proto",
        "@com_google_googleapis//google/api/expr/v1alpha1:expr_java_proto",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:info_picocli_picocli",
        "@maven//:junit_junit",
    ],
)

junit4_test_suites(
    name = "test_suites",
    sizes = [
        "small",
    ],
    src_dir = "src/test/java",
    deps = [":tests"],
)
