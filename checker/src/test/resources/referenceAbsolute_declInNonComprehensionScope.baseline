Source: [1].all(x, .x == 'a') && .x == 'a'
=====>

_&&_(
  __comprehension__(
    // Variable
    x,
    // Target
    [
      1~int
    ]~list(int),
    // Accumulator
    @result,
    // Init
    true~bool,
    // LoopCondition
    @not_strictly_false(
      @result~bool^@result
    )~bool^not_strictly_false,
    // LoopStep
    _&&_(
      @result~bool^@result,
      _==_(
        .x~string^.x,
        "a"~string
      )~bool^equals
    )~bool^logical_and,
    // Result
    @result~bool^@result)~bool,
  _==_(
    .x~string^.x,
    "a"~string
  )~bool^equals
)~bool^logical_and
